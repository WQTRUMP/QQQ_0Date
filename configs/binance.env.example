# [INPUT]: 依赖 Binance USD-M Testnet 固定端点、配置硬时序区间、分模式 SQLite 隔离与 Dashboard loopback 约束
# [OUTPUT]: 对外提供固定 BTCUSDT/1m 策略的无密钥模板，默认 paper，隔离恢复库且 testnet 需显式确认
# [POS]: configs 的 Binance 运行时样例，仅描述新交易链路，不与其他账户配置共享密钥
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

# 安全默认：paper 仅观察；显式 TRADING_ENABLED=true 后也只记录本地模拟成交。CLI 模式覆盖此值。
EXECUTION_MODE=paper
BINANCE_ENV=testnet
BINANCE_SYMBOLS=BTCUSDT
TRADING_ENABLED=false

# 两个模式都只允许 Binance USD-M Testnet 端点，不接受生产 URL。
BINANCE_REST_URL=https://demo-fapi.binance.com
BINANCE_WS_URL=wss://demo-fstream.binance.com
BINANCE_RECV_WINDOW_MS=5000
# 单次 HTTP 超时只允许 1..30 秒，防止停机与恢复被失真长等待占用。
BINANCE_REQUEST_TIMEOUT_SEC=10
BINANCE_HISTORY_LIMIT=250
# 固定 1m；任何其他周期都会在联网前拒绝。
BINANCE_KLINE_INTERVAL=1m

# testnet 模式才需要密钥和确认句；不要把真实值提交到仓库。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_TRADING_CONFIRM=

# 入场固定为闭合 1m EMA5/EMA13 交叉；ATR14 只负责风险距离，不开放指标调参。
ATR_STOP_MULTIPLE=1.5
REWARD_RISK_RATIO=2

# 线性合约风控均使用 0..1 比例；数量仍以 exchangeInfo 动态量化。
RISK_PER_TRADE_FRACTION=0.005
MAX_DAILY_LOSS_FRACTION=0.02
MAX_NOTIONAL_FRACTION=0.25
MAX_LEVERAGE=2
MAX_SPREAD_BPS=8
# 1m 闭柱策略的新鲜度硬边界：book 0.25..10 秒，signal 1..60 秒，account poll 1..15 秒。
# 默认 15 秒为账户级高权重 REST 审计节奏；paper 的实时 mark 本地保护不受 Testnet REST 冷却门影响。
MAX_BOOK_AGE_SECONDS=3
SIGNAL_MAX_AGE_SECONDS=15
ENTRY_SLIPPAGE_BPS=2
ACCOUNT_POLL_SECONDS=15

# paper/testnet 永不共用订单阶段、保护计划、资金基线或成交账本。
# 启动门按规范化绝对路径比较；相对路径、绝对路径或含 ../ 的别名也不能指向同一文件。
PAPER_STARTING_EQUITY=10000
PAPER_FEE_BPS=4
BINANCE_PAPER_DB_PATH=logs/binance_trading.paper.db
BINANCE_TESTNET_DB_PATH=logs/binance_trading.testnet.db

# Dashboard 只允许 127.0.0.1、::1 或 localhost，不可暴露到外部网卡。
BINANCE_DASHBOARD_HOST=127.0.0.1
BINANCE_DASHBOARD_PORT=8765
BINANCE_DASHBOARD_HTML=Binance_Dashboard.html
